# Copy this file to .env.local and fill in a key to enable AI mission planning.
# Without a key, missions still run fully — they just fall back to the
# built-in Travel/Finance/Shopping templates instead of an LLM-generated plan.

# Groq has a genuinely free, no-credit-card developer tier — good default if
# you don't have an OpenAI/Anthropic key. Get one at https://console.groq.com
VITE_LLM_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint works: Groq, OpenAI,
# OpenRouter, or a local Ollama server (e.g. http://localhost:11434/v1).
VITE_LLM_BASE_URL=https://api.groq.com/openai/v1

# Must be a model your provider/key actually has access to.
VITE_LLM_MODEL=llama-3.3-70b-versatile
